# DVC does not honour .gitignore for its own traversal, so every large untracked
# tree has to be listed here or `dvc status` walks all of it on every call.
#
# Deliberately NOT listed: .data/ and .models/ — those are the DVC-tracked outs.

.dag_cache/
runs/
mlruns/
mlartifacts/
artifacts/
.venv/
.git/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.import_linter_cache/
.claude/
notebooks/
__pycache__/

# Finder writes a .DS_Store into every directory it opens, and this is the one
# pattern here that deliberately reaches INSIDE .data/ and .models/. Without it
# the file joins the tracked directory's hash, so merely opening .data/ in Finder
# changes the .dir hash: .data.dvc shows modified, and you get a pointer commit
# and a push for a file that means nothing. .gitignore lists it too, but per the
# note at the top DVC does not read .gitignore.
.DS_Store
