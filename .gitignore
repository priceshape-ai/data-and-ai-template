# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ────────────────────────────────────────────────
.venv/
venv/
ENV/

# ── IDE / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Testing & linting ───────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml
.ruff_cache/
.mypy_cache/
.import_linter_cache/

# ── Claude Code ─────────────────────────────────────────────────────────
# CLAUDE.md, .claude/rules/, .claude/hooks/ and .claude/skills/ ARE committed:
# they are how the architecture explains and defends itself. Only per-machine
# settings stay out.
.claude/settings.local.json

# ── Environment ─────────────────────────────────────────────────────────
.env
.env.local

# ── Data & models: DVC's business, never git's ──────────────────────────
# Ignored wholesale, including any .gitkeep. DVC refuses to manage a directory
# that git tracks anything inside — `dvc add .data` fails outright with
# "output '.data' is already tracked by SCM" — so committing a placeholder to
# preserve the layout breaks the tool it was meant to serve. `make dvc-pull`
# creates these directories the first time it runs.
.data/
.models/

# A safety net against committing data by accident. Test fixtures are exempt —
# small committed fixtures are how the test suite stays hermetic.
*.csv
*.parquet
*.arrow
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.safetensors
!tests/**/fixtures/**

# ── MLflow (local runs only; the real server is remote) ─────────────────
mlflow.db
mlruns/
mlartifacts/

# ── DVC: the .dvc files and dvc.lock are tracked, the cache is not ──────
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# ── Pipeline outputs ────────────────────────────────────────────────────
.dag_cache/
runs/
artifacts/
logs/

# ── Misc ────────────────────────────────────────────────────────────────
*.log
tmp/
