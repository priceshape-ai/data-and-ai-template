# Tracks .data/ in the `datasets` remote.
#
# The remote is pinned here rather than in .dvc/config's core.remote so that
# `dvc push` cannot put datasets in the models bucket. Keep the pin when you
# re-add.
#
# The hash fields are empty until the first `dvc add .data` (or `make dvc-add`),
# which fills in md5/size/nfiles. That is the expected state of a fresh project.
outs:
- path: .data
  remote: datasets
