{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/architecture_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking the edit against the architecture..."
          }
        ]
      }
    ]
  }
}
