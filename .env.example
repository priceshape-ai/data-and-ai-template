# Copy to .env and fill in. .env is git-ignored.
#   cp .env.example .env
#
# pipelines/runner.py is the only place that calls load_dotenv(). Production
# reads real environment variables, injected by the Kubernetes manifests in
# deploy/ — there is no .env in the image.

# ── Runtime ─────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# ── API serving (production reads these) ────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── AWS / S3 — DVC remotes and model weight sync ────────────────────────
# Simplest option: skip the keys below and export a named profile instead —
#   export AWS_PROFILE=data
# DVC, boto3 and the aws CLI all read it the same way. That profile assumes
# arn:aws:iam::626635402249:role/DataDevRole, which is what grants access to the
# datasets and models buckets. In CI the same role is reached through OIDC as
# ${{ secrets.OIDC_ROLE_ARN }} — see .github/workflows/build.yml.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# ── MLflow — development and CI only, never production ──────────────────
# Leave MLFLOW_TRACKING_URI empty to disable run logging entirely; the pipeline
# still runs. Point it at the shared server to record runs.
# MLFLOW_TRACKING_URI=http://mlflow.internal:5000
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=project-name

# IMPORTANT: the browser URL is NOT the API URL. https://mlflow-api.data.priceshape.io
# sits behind the platform's SSO proxy, which answers an API call with a 302 to a
# login page. MLflow then parses HTML and fails with "response body was not in a
# valid JSON format" — and no username or password gets past it, because the proxy
# wants an OAuth session, not HTTP basic auth.
#
# Reach the server directly instead:
#
#   From a Kubeflow pod (in-cluster, no auth needed):
#     MLFLOW_TRACKING_URI=http://mlflow.mlflow.svc.cluster.local
#
#   From a laptop, via a port-forward. The server enforces a Host allowlist, so
#   the hostname has to survive — map it to localhost for the session:
#     sudo sh -c 'echo "127.0.0.1 mlflow.data.priceshape.io" >> /etc/hosts'
#     kubectl port-forward -n mlflow svc/mlflow 5000:80
#     MLFLOW_TRACKING_URI=http://mlflow.data.priceshape.io:5000
#
# The two below apply only to a server running MLflow's own basic-auth plugin.
# The shared one does not, so leaving them empty is correct.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# A bearer token, if the proxy is ever configured to accept one:
# MLFLOW_TRACKING_TOKEN=
# Only for a server with a self-signed certificate. Never against a public one.
# MLFLOW_TRACKING_INSECURE_TLS=false

# tracking/mlflow_logger.py lowers MLflow's own defaults (7 retries, 120s timeout)
# so an unreachable server costs seconds instead of stalling a finished pipeline
# for minutes. Raise them if the server is genuinely slow rather than down.
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
# MLFLOW_HTTP_REQUEST_TIMEOUT=10

# ── Kubeflow — development only ─────────────────────────────────────────
# With KUBEFLOW_ENDPOINT empty the pipeline runs locally. Set it to compile the
# same DAG to KFP and submit it instead.
KUBEFLOW_ENDPOINT=
KUBEFLOW_S3_BUCKET=project-name
KUBEFLOW_S3_ENDPOINT=http://localhost:9000    # MinIO in-cluster
KUBEFLOW_BASE_IMAGE=python:3.12-slim

# ── Escape hatch for the git-clean gate ─────────────────────────────────
# Set to 1 to run the pipeline on a dirty tree. The MLflow run is then tagged
# git.dirty=true and is not reproducible from its commit — use sparingly.
# PIPELINE_ALLOW_DIRTY=0
